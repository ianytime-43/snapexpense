# Copy to .env.e2e and fill with real values. .env.e2e is git-ignored.
# A dedicated Supabase user created specifically for E2E runs.
E2E_TEST_EMAIL=e2e-test@snapexpense.local
E2E_TEST_PASSWORD=replace-with-a-long-random-password

# Same Supabase project as the app (or a dedicated test project).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Plaid sandbox — if unset, bank-connect tests skip.
# PLAID_SECRET=
