SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
GOOGLE_CLOUD_VISION_API_KEY=your-google-cloud-vision-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-app.railway.app/api/calendar/callback
MICROSOFT_OAUTH_CLIENT_ID=your-microsoft-oauth-client-id
MICROSOFT_OAUTH_CLIENT_SECRET=your-microsoft-oauth-client-secret
MICROSOFT_OAUTH_REDIRECT_URI=https://your-app.railway.app/api/outlook/callback
FRONTEND_URL=https://your-app.vercel.app
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain
# HMAC signing key used to verify Mailgun inbound webhooks.
# Mailgun dashboard -> Sending -> Webhooks -> HTTP webhook signing key.
# REQUIRED in production; webhook is rejected if unset when APP_ENV=production.
MAILGUN_SIGNING_KEY=your-mailgun-http-webhook-signing-key
# development | staging | production
APP_ENV=development
REMINDER_CRON_SECRET=generate-a-random-secret

# Plaid bank integration (https://dashboard.plaid.com)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://your-app.railway.app/api/bank/webhook
